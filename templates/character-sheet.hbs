              <button type="button" class="fts-star {{#if this.favorite}}active{{/if}}" data-action="toggleFavorite" title="{{localize 'FAW.Sheet.Favorite'}}" aria-label="{{localize 'FAW.Sheet.Favorite'}}" aria-pressed="{{#if this.favorite}}true{{else}}false{{/if}}" data-kind="skills" data-key="{{this.key}}"><i class="fa-solid fa-star" aria-hidden="true"></i></button>
              <button type="button" class="fts-skill-main" data-action="rollSkill" data-skill-key="{{this.key}}" title="{{localize 'FAW.Sheet.RollSkill'}}"><span class="fts-skill-name">{{this.name}}</span><strong class="fts-skill-rank">{{this.rank}}</strong></button>
            </div>
            {{/each}}
            {{#unless model.skills.length}}<div class="fts-empty-state"><i class="fa-solid fa-chart-simple" aria-hidden="true"></i><strong>{{localize 'FAW.Sheet.NoSkills'}}</strong><span>{{localize 'FAW.Sheet.NoSkillsHint'}}</span></div>{{/unless}}
          </div>
        </section>
        {{/unless}}

        {{#unless sections.stunts.hidden}}
        <section class="fts-card {{#if sections.stunts.wide}}fts-section-wide{{/if}}" style="order:{{sections.stunts.order}}" data-section="stunts">
          <header class="fts-card-header"><div class="fts-card-heading"><i class="fa-solid fa-wand-sparkles" aria-hidden="true"></i><strong>{{localize 'FAW.Sheet.Stunts'}}</strong><span class="fts-count">{{model.stunts.length}}</span>{{#if editable}}<button type="button" class="fts-card-tool" data-action="addStunt" title="{{localize 'FAW.Sheet.AddStunt'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i><span>{{localize 'FAW.Sheet.AddStunt'}}</span></button>{{/if}}<button type="button" class="fts-card-tool" data-action="openStuntDatabase" title="{{localize 'FAW.Sheet.StuntDatabase'}}"><i class="fa-solid fa-book" aria-hidden="true"></i><span>{{localize 'FAW.Sheet.StuntDatabase'}}</span></button>{{#if isGM}}<button type="button" class="fts-card-tool" data-action="uploadAllStunts" title="{{localize 'FAW.Sheet.UploadAllStunts'}}"><i class="fa-solid fa-upload" aria-hidden="true"></i><span>{{localize 'FAW.Sheet.UploadAllStunts'}}</span></button>{{/if}}</div><span class="fts-search-control"><input data-sheet-search="stunts" type="search" placeholder="{{localize 'FAW.Sheet.Search'}}" aria-label="{{localize 'FAW.Sheet.Search'}}" aria-controls="fts-list-stunts" aria-describedby="fts-search-status-stunts"><span class="fts-search-count" id="fts-search-status-stunts" data-sheet-search-status="stunts" aria-live="polite"></span></span></header>
          <div class="fts-card-body fts-list" id="fts-list-stunts" data-search-group="stunts">
            {{#each model.stunts}}
            <article class="fts-stunt-row" data-search-text="{{this.search}}" data-favorite-anchor="stunts:{{this.key}}" {{#if ../isGM}}draggable="true" data-fco-drag-type="stunt" data-fco-drag-key="{{this.key}}"{{/if}}>
              <div class="fts-row-title fts-row-title-with-tools">
                <div class="fts-row-title-main">
                  <button type="button" class="fts-star {{#if this.favorite}}active{{/if}}" data-action="toggleFavorite" title="{{localize 'FAW.Sheet.Favorite'}}" aria-label="{{localize 'FAW.Sheet.Favorite'}}" aria-pressed="{{#if this.favorite}}true{{else}}false{{/if}}" data-kind="stunts" data-key="{{this.key}}"><i class="fa-solid fa-star" aria-hidden="true"></i></button>
                  <strong>{{this.name}}</strong>
                  {{#if this.linkedSkill}}<span class="fts-pill">{{this.linkedSkill}}</span>{{/if}}
                  {{#each this.actions}}<span class="fts-action-code" title="{{this.label}}" aria-label="{{this.label}}"><i class="fa-solid {{this.icon}}" aria-hidden="true"></i></span>{{/each}}
                </div>
                <div class="fts-row-tools">
                  {{#if this.rollable}}<button type="button" data-action="rollStunt" data-stunt-key="{{this.key}}" data-stunt-name="{{this.rawName}}" title="{{localize 'FAW.Sheet.RollStunt'}}"><i class="fa-solid fa-dice" aria-hidden="true"></i></button>{{/if}}
                  {{#if this.macro}}<button type="button" data-action="runStuntMacro" data-stunt-key="{{this.key}}" title="{{localize 'FAW.Sheet.RunMacro'}}"><i class="fa-solid fa-bolt" aria-hidden="true"></i></button><button type="button" data-action="openStuntMacro" data-stunt-key="{{this.key}}" title="{{localize 'FAW.Sheet.OpenMacro'}}"><i class="fa-solid fa-code" aria-hidden="true"></i></button>{{/if}}
                  {{#if ../editable}}{{#unless this.extraOwned}}<button type="button" data-action="editStunt" data-stunt-key="{{this.key}}" data-stunt-name="{{this.rawName}}" title="{{localize 'FAW.Sheet.EditStunt'}}"><i class="fa-solid fa-pen" aria-hidden="true"></i></button><button type="button" class="is-danger" data-action="deleteStunt" data-stunt-key="{{this.key}}" title="{{localize 'FAW.Sheet.DeleteStunt'}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/unless}}{{/if}}
                  {{#if ../isGM}}{{#unless this.extraOwned}}<button type="button" data-action="addStuntToDatabase" data-stunt-key="{{this.key}}" title="{{localize 'FAW.Sheet.AddStuntToDatabase'}}"><i class="fa-solid fa-upload" aria-hidden="true"></i></button>{{/unless}}{{/if}}
                </div>
              </div>
              {{#if this.boxes.length}}<div class="fts-stunt-boxes">{{#each this.boxes}}<button type="button" class="fts-track-box {{#if this.checked}}checked{{/if}}" data-action="toggleStuntBox" data-stunt-key="{{../key}}" data-index="{{this.index}}" aria-pressed="{{#if this.checked}}true{{else}}false{{/if}}" {{#unless ../../editable}}disabled{{/unless}}>{{this.label}}</button>{{/each}}</div>{{/if}}
              {{#if this.description}}<div class="fts-stunt-description fts-prose editor-content">{{{this.descriptionEnriched}}}</div>{{/if}}
              <div class="fts-stunt-meta">
                {{#if this.refreshCost}}<span><strong>{{localize 'FAW.Sheet.RefreshCost'}}:</strong> {{this.refreshCost}}</span>{{/if}}
                {{#if this.bonus}}<span><strong>{{localize 'FAW.Sheet.Bonus'}}:</strong> {{this.bonus}}</span>{{/if}}
              </div>
              {{#if this.notes}}
              <details class="fts-native-details"><summary>{{localize 'FAW.Sheet.StuntNotes'}}</summary><div class="fts-prose editor-content">{{{this.notesEnriched}}}</div></details>
              {{/if}}
            </article>
            {{/each}}
            {{#unless model.stunts.length}}<div class="fts-empty-state"><i class="fa-solid fa-wand-sparkles" aria-hidden="true"></i><strong>{{localize 'FAW.Sheet.NoStunts'}}</strong><span>{{localize 'FAW.Sheet.NoStuntsHint'}}</span></div>{{/unless}}
          </div>
        </section>
        {{/unless}}

        {{#unless sections.tracks.hidden}}
        <section class="fts-card {{#if sections.tracks.wide}}fts-section-wide{{/if}}" style="order:{{sections.tracks.order}}" data-section="tracks">
          <header class="fts-card-header"><div class="fts-card-heading"><i class="fa-solid fa-heart-pulse" aria-hidden="true"></i><strong>{{localize 'FAW.Sheet.Tracks'}}</strong><span class="fts-count">{{model.tracks.length}}</span>{{#if editable}}<button type="button" class="fts-card-tool" data-action="manageTracks" title="{{localize 'FAW.Sheet.ManageTracks'}}"><i class="fa-solid fa-gear" aria-hidden="true"></i><span>{{localize 'FAW.Sheet.ManageTracks'}}</span></button>{{/if}}</div></header>
          <div class="fts-card-body fts-track-groups">
            {{#unless campaignMode}}{{#if model.stressTracks.length}}
            <div class="fts-track-group"><h4>{{localize 'FAW.Sheet.Stress'}}</h4>
              {{#each model.stressTracks}}
              <div class="fts-track-row" {{#if ../isGM}}draggable="true" data-fco-drag-type="track" data-fco-drag-key="{{this.key}}"{{/if}}><div class="fts-track-name"><span><strong>{{this.name}}</strong>{{#if this.category}}<small>{{this.category}}</small>{{/if}}</span>{{#if this.rollable}}<button type="button" class="fts-inline-roll" data-action="rollTrack" data-track-key="{{this.key}}" title="{{localize 'FAW.Sheet.RollTrack'}}"><i class="fa-solid fa-dice" aria-hidden="true"></i></button>{{/if}}</div><div class="fts-track-boxes">
                {{#each this.boxes}}<button type="button" class="fts-track-box {{#if this.checked}}checked{{/if}}" data-action="toggleTrackBox" aria-pressed="{{#if this.checked}}true{{else}}false{{/if}}" data-track-key="{{../key}}" data-index="{{this.index}}" {{#unless ../../editable}}disabled{{/unless}}>{{this.label}}</button>{{/each}}
              </div>
              {{#if this.hasDetails}}<details class="fts-native-details fts-track-details"><summary>{{localize 'FAW.Sheet.Details'}}</summary>
                {{#if this.recoveryType}}<div class="fts-native-meta-line"><strong>{{localize 'FAW.Sheet.RecoveryType'}}:</strong> {{this.recoveryType}}</div>{{/if}}
                {{#if this.description}}<div class="fts-native-rich-block"><strong>{{localize 'FAW.Sheet.TrackDescription'}}</strong><div class="fts-prose editor-content">{{{this.descriptionEnriched}}}</div></div>{{/if}}
                {{#if this.whenMarked}}<div class="fts-native-rich-block"><strong>{{localize 'FAW.Sheet.WhenMarked'}}</strong><div class="fts-prose editor-content">{{{this.whenMarkedEnriched}}}</div></div>{{/if}}
                {{#if this.recoveryConditions}}<div class="fts-native-rich-block"><strong>{{localize 'FAW.Sheet.RecoveryConditions'}}</strong><div class="fts-prose editor-content">{{{this.recoveryConditionsEnriched}}}</div></div>{{/if}}
                {{#if ../editable}}{{#unless this.extraOwned}}<div class="fts-native-rich-block"><strong>{{localize 'FAW.Sheet.TrackNotes'}}</strong><prose-mirror toggled="true" name="system.tracks.{{this.key}}.notes" value="{{this.notes}}" data-document-u-u-i-d="{{../actor.uuid}}" collaborate="true" class="fts-rich-editor fts-inline-rich-editor">{{{this.notesEnriched}}}</prose-mirror></div>{{else}}{{#if this.notes}}<div class="fts-native-rich-block"><strong>{{localize 'FAW.Sheet.TrackNotes'}}</strong><div class="fts-prose editor-content">{{{this.notesEnriched}}}</div></div>{{/if}}{{/unless}}{{else}}{{#if this.notes}}<div class="fts-native-rich-block"><strong>{{localize 'FAW.Sheet.TrackNotes'}}</strong><div class="fts-prose editor-content">{{{this.notesEnriched}}}</div></div>{{/if}}{{/if}}
              </details>{{/if}}
              </div>
              {{/each}}
            </div>
            {{/if}}{{/unless}}
            {{#if model.consequenceTracks.length}}
            <div class="fts-track-group"><h4>{{localize 'FAW.Sheet.Consequences'}}</h4>
              {{#each model.consequenceTracks}}
              <div class="fts-track-row fts-consequence-row" {{#if ../isGM}}draggable="true" data-fco-drag-type="track" data-fco-drag-key="{{this.key}}"{{/if}}><div class="fts-track-name"><span><strong>{{this.name}}</strong></span>{{#if this.rollable}}<button type="button" class="fts-inline-roll" data-action="rollTrack" data-track-key="{{this.key}}" title="{{localize 'FAW.Sheet.RollTrack'}}"><i class="fa-solid fa-dice" aria-hidden="true"></i></button>{{/if}}</div><div class="fts-track-boxes">
                {{#each this.boxes}}<button type="button" class="fts-track-box {{#if this.checked}}checked{{/if}}" data-action="toggleTrackBox" aria-pressed="{{#if this.checked}}true{{else}}false{{/if}}" data-track-key="{{../key}}" data-index="{{this.index}}" {{#unless ../../editable}}disabled{{/unless}}>{{this.label}}</button>{{/each}}
              </div>
              {{#if ../editable}}<input name="system.tracks.{{this.key}}.aspect.name" class="fts-consequence-name" type="text" value="{{this.aspectName}}" placeholder="{{localize 'FAW.Sheet.ConsequenceAspect'}}">{{else}}{{#if this.aspectName}}<div class="fts-consequence-name fts-static-field">{{this.aspectName}}</div>{{/if}}{{/if}}
              {{#if this.hasDetails}}<details class="fts-native-details fts-track-details"><summary>{{localize 'FAW.Sheet.Details'}}</summary>
                {{#if this.recoveryType}}<div class="fts-native-meta-line"><strong>{{localize 'FAW.Sheet.RecoveryType'}}:</strong> {{this.recoveryType}}</div>{{/if}}
                {{#if this.description}}<div class="fts-native-rich-block"><strong>{{localize 'FAW.Sheet.TrackDescription'}}</strong><div class="fts-prose editor-content">{{{this.descriptionEnriched}}}</div></div>{{/if}}
                {{#if this.whenMarked}}<div class="fts-native-rich-block"><strong>{{localize 'FAW.Sheet.WhenMarked'}}</strong><div class="fts-prose editor-content">{{{this.whenMarkedEnriched}}}</div></div>{{/if}}
                {{#if this.recoveryConditions}}<div class="fts-native-rich-block"><strong>{{localize 'FAW.Sheet.RecoveryConditions'}}</strong><div class="fts-prose editor-content">{{{this.recoveryConditionsEnriched}}}</div></div>{{/if}}
                {{#if ../editable}}{{#unless this.extraOwned}}<div class="fts-native-rich-block"><strong>{{localize 'FAW.Sheet.TrackNotes'}}</strong><prose-mirror toggled="true" name="system.tracks.{{this.key}}.notes" value="{{this.notes}}" data-document-u-u-i-d="{{../actor.uuid}}" collaborate="true" class="fts-rich-editor fts-inline-rich-editor">{{{this.notesEnriched}}}</prose-mirror></div>{{else}}{{#if this.notes}}<div class="fts-native-rich-block"><strong>{{localize 'FAW.Sheet.TrackNotes'}}</strong><div class="fts-prose editor-content">{{{this.notesEnriched}}}</div></div>{{/if}}{{/unless}}{{else}}{{#if this.notes}}<div class="fts-native-rich-block"><strong>{{localize 'FAW.Sheet.TrackNotes'}}</strong><div class="fts-prose editor-content">{{{this.notesEnriched}}}</div></div>{{/if}}{{/if}}
              </details>{{/if}}
              </div>
              {{/each}}
            </div>
            {{/if}}
            {{#unless model.tracks.length}}<div class="fts-empty-state"><i class="fa-solid fa-heart-pulse" aria-hidden="true"></i><strong>{{localize 'FAW.Sheet.NoTracks'}}</strong><span>{{localize 'FAW.Sheet.NoTracksHint'}}</span></div>{{/unless}}
          </div>
        </section>
        {{/unless}}

        {{#unless sections.extras.hidden}}
        <section class="fts-card {{#if sections.extras.wide}}fts-section-wide{{/if}}" style="order:{{sections.extras.order}}" data-section="extras">
          <header class="fts-card-header"><div class="fts-card-heading"><i class="fa-solid fa-puzzle-piece" aria-hidden="true"></i><strong>{{localize 'FAW.Sheet.Extras'}}</strong><span class="fts-count">{{model.extras.length}}</span>{{#if isGM}}<button type="button" class="fts-card-tool" data-action="addExtra" title="{{localize 'FAW.Extras.Create'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i><span>{{localize 'FAW.Extras.Create'}}</span></button><button type="button" class="fts-card-tool" data-action="openExtraLibrary" title="{{localize 'FAW.Extras.LibraryHint'}}"><i class="fa-solid fa-book" aria-hidden="true"></i><span>{{localize 'FAW.Extras.Library'}}</span></button><button type="button" class="fts-card-tool" data-action="importExtraMechanics" title="{{localize 'FAW.Extras.ImportTitle'}}"><i class="fa-solid fa-paste" aria-hidden="true"></i><span>{{localize 'FAW.Extras.Import'}}</span></button>{{/if}}<button type="button" class="fts-card-tool" data-action="exportAllExtraMechanics" title="{{localize 'FAW.Extras.ExportTitle'}}"><i class="fa-solid fa-copy" aria-hidden="true"></i><span>{{localize 'FAW.Extras.Export'}}</span></button></div></header>
          <div class="fts-card-body fts-list">
            {{#each model.extras}}
            <article class="fts-extra-row" draggable="true" data-extra-drag="{{this.id}}">
              <img src="{{this.img}}" alt="" class="fts-extra-img">
              <button type="button" class="fts-extra-main" data-action="openExtra" data-item-id="{{this.id}}"><strong>{{this.name}}</strong>{{#if this.descriptionText}}<small>{{this.descriptionText}}</small>{{/if}}</button>
              {{#if ../editable}}<div class="fts-row-tools">{{#if ../isGM}}<button type="button" data-action="editExtraMechanics" data-item-id="{{this.id}}" title="{{localize 'FAW.Extras.Edit'}}"><i class="fa-solid fa-sliders" aria-hidden="true"></i></button>{{/if}}{{#if this.builderUsable}}<button type="button" data-action="useExtraMechanics" data-item-id="{{this.id}}" title="{{localize 'FAW.Extras.Use'}}"><i class="fa-solid fa-play" aria-hidden="true"></i></button><span draggable="true" data-faw-hotbar="{{this.id}}" class="fts-extra-hotbar" title="{{localize 'FAW.Extras.Hotbar'}}"><i class="fa-solid fa-grip-vertical" aria-hidden="true"></i></span>{{/if}}{{#if ../isGM}}<button type="button" data-action="saveExtraToLibrary" data-item-id="{{this.id}}" title="{{localize 'FAW.Extras.SaveToLibrary'}}"><i class="fa-solid fa-bookmark" aria-hidden="true"></i></button>{{/if}}<button type="button" data-action="exportExtraMechanics" data-item-id="{{this.id}}" title="{{localize 'FAW.Extras.ExportOne'}}"><i class="fa-solid fa-file-export" aria-hidden="true"></i></button><button type="button" class="fts-toggle {{#if this.active}}active{{/if}}" data-action="toggleExtra" data-item-id="{{this.id}}" title="{{localize 'FAW.Sheet.ToggleExtra'}}" aria-label="{{localize 'FAW.Sheet.ToggleExtra'}}" aria-pressed="{{#if this.active}}true{{else}}false{{/if}}"><i class="fa-solid {{#if this.active}}fa-toggle-on{{else}}fa-toggle-off{{/if}}" aria-hidden="true"></i></button><button type="button" class="is-danger" data-action="deleteExtra" data-item-id="{{this.id}}" title="{{localize 'FAW.Sheet.DeleteExtra'}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button></div>{{/if}}
            </article>
            {{/each}}
            {{#if model.extraStatuses.length}}<div class="fts-extra-statuses">{{#each model.extraStatuses}}<span class="fts-pill" title="{{localize 'FAW.Extras.Status'}}">{{this.name}}</span>{{/each}}</div>{{/if}}
            {{#unless model.extras.length}}<div class="fts-empty-state"><i class="fa-solid fa-puzzle-piece" aria-hidden="true"></i><strong>{{localize 'FAW.Sheet.NoExtras'}}</strong><span>{{localize 'FAW.Sheet.NoExtrasHint'}}</span></div>{{/unless}}
          </div>
        </section>
        {{/unless}}
      </div>
    </section>

    <section class="fts-tab-panel {{#unless developmentActive}}fts-tab-hidden{{/unless}}" id="fts-panel-development" role="tabpanel" aria-labelledby="fts-tab-development" data-sheet-tab="development">
      <div class="fts-story-stack fts-development-stack">
        <section class="fts-card">
          <header class="fts-card-header"><div class="fts-card-heading"><i class="fa-solid fa-chart-line" aria-hidden="true"></i><strong>{{localize 'FMS.Timeline.Development'}}</strong></div></header>
          <div class="fts-card-body">
            <div class="fts-development-overview">
              <div><small>{{localize 'FMS.Timeline.Stage'}}</small><strong>{{development.stage}}</strong></div>
              <div><small>{{localize 'FMS.Type.minor'}}</small><strong>{{development.counts.minor}}</strong></div>
              <div><small>{{localize 'FMS.Type.significant'}}</small><strong>{{development.counts.significant}}</strong></div>
              <div><small>{{localize 'FMS.Type.major'}}</small><strong>{{development.counts.major}}</strong></div>
              <div><small>{{localize 'FMS.SkillPointsBank'}}</small><strong>{{development.bank}}</strong></div>
            </div>
            <div class="fts-development-actions">
              <button type="button" data-action="openCampaignTimeline"><i class="fa-solid fa-timeline" aria-hidden="true"></i> {{localize 'FMS.Timeline.OpenTimeline'}}</button>
              {{#if development.active}}{{#unless development.active.completed}}<button type="button" data-action="openMilestoneDevelopment"><i class="fa-solid fa-arrow-up-right-dots" aria-hidden="true"></i> {{localize 'FMS.Timeline.WorkOn'}}</button>{{/unless}}{{/if}}
            </div>
            {{#if development.active}}
              <div class="fts-development-active"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{development.active.title}} — {{development.active.typeLabel}} ({{#if development.active.completed}}{{localize 'FMS.Completed'}}{{else}}{{localize 'FMS.Pending'}}{{/if}})</div>
            {{/if}}
          </div>
        </section>
        <section class="fts-card">
          <header class="fts-card-header"><div class="fts-card-heading"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i><strong>{{localize 'FMS.Timeline.PersonalHistory'}}</strong></div></header>
          <div class="fts-card-body fts-development-history">
            {{#each development.entries}}
              <article class="fts-development-entry">
                <header><strong>{{title}}</strong><small>{{typeLabel}} · {{dateLabel}} {{sessionLabel}}</small></header>
                {{#if hasChanges}}<ul>{{#each changes}}<li>{{this}}</li>{{/each}}</ul>{{else}}<small>{{localize 'FMS.Timeline.NoChanges'}}</small>{{/if}}
                {{#if reasons.length}}<details><summary>{{localize 'FMS.StoryExplanation'}}</summary><ul>{{#each reasons}}<li>{{this}}</li>{{/each}}</ul></details>{{/if}}
              </article>
            {{/each}}
            {{#unless development.hasHistory}}<div class="fts-empty-state">{{localize 'FMS.Timeline.EmptyPersonal'}}</div>{{/unless}}
          </div>
        </section>
      </div>
    </section>

    <section class="fts-tab-panel {{#unless storyActive}}fts-tab-hidden{{/unless}}" id="fts-panel-story" role="tabpanel" aria-labelledby="fts-tab-story" data-sheet-tab="story">
      <div class="fts-story-stack">

        {{#unless sections.description.hidden}}
        <section class="fts-card fts-story-text-card fts-story-description" style="order:{{sections.description.order}}" data-section="description">
          <header class="fts-card-header"><div><i class="fa-solid fa-id-card" aria-hidden="true"></i><strong>{{localize 'FAW.Sheet.Description'}}</strong></div></header>
          <div class="fts-card-body fts-story-editor-body">{{#if editable}}<prose-mirror toggled="true" name="system.details.description.value" value="{{model.description}}" data-document-u-u-i-d="{{actor.uuid}}" collaborate="true" class="fts-rich-editor" placeholder="{{localize 'FAW.Sheet.DescriptionHint'}}">{{{model.descriptionEnriched}}}</prose-mirror>{{else}}<div class="fts-prose editor-content">{{{model.descriptionEnriched}}}</div>{{/if}}</div>
        </section>
        {{/unless}}

        {{#unless sections.biography.hidden}}
        <section class="fts-card fts-story-text-card fts-story-biography" style="order:{{sections.biography.order}}" data-section="biography">
          <header class="fts-card-header"><div><i class="fa-solid fa-book" aria-hidden="true"></i><strong>{{localize 'FAW.Sheet.Biography'}}</strong></div></header>
          <div class="fts-card-body fts-story-editor-body">{{#if editable}}<prose-mirror toggled="true" name="system.details.biography.value" value="{{model.biography}}" data-document-u-u-i-d="{{actor.uuid}}" collaborate="true" class="fts-rich-editor" placeholder="{{localize 'FAW.Sheet.BiographyHint'}}">{{{model.biographyEnriched}}}</prose-mirror>{{else}}<div class="fts-prose editor-content">{{{model.biographyEnriched}}}</div>{{/if}}</div>
        </section>
        {{/unless}}

        {{#unless sections.notes.hidden}}
        <section class="fts-card fts-story-text-card fts-story-notes" style="order:{{sections.notes.order}}" data-section="notes">
          <header class="fts-card-header"><div><i class="fa-solid fa-note-sticky" aria-hidden="true"></i><strong>{{localize 'FAW.Sheet.Notes'}}</strong>{{#if model.notesPrivate}}<span class="fts-pill"><i class="fa-solid fa-lock" aria-hidden="true"></i> {{localize 'FAW.Sheet.GmOnlyShort'}}</span>{{/if}}</div>{{#if isGM}}<button type="button" class="fts-subtle-button {{#if model.notesPrivate}}active{{/if}}" data-action="toggleGmNotes"><i class="fa-solid {{#if model.notesPrivate}}fa-lock{{else}}fa-lock-open{{/if}}" aria-hidden="true"></i> {{localize 'FAW.Sheet.GmOnlyShort'}}</button>{{/if}}</header>
          <div class="fts-card-body fts-story-editor-body">{{#if model.notesVisible}}{{#if editable}}<prose-mirror toggled="true" name="system.details.notes.value" value="{{model.notes}}" data-document-u-u-i-d="{{actor.uuid}}" collaborate="true" class="fts-rich-editor" placeholder="{{localize 'FAW.Sheet.NotesHint'}}">{{{model.notesEnriched}}}</prose-mirror>{{else}}<div class="fts-prose editor-content">{{{model.notesEnriched}}}</div>{{/if}}{{else}}<div class="fts-private-note"><i class="fa-solid fa-lock" aria-hidden="true"></i> {{localize 'FAW.Sheet.GmNotesHidden'}}</div>{{/if}}</div>
        </section>
        {{/unless}}

        {{#unless sections.custom.hidden}}
        <section class="fts-card {{#if sections.custom.wide}}fts-section-wide{{/if}}" style="order:{{sections.custom.order}}" data-section="custom"><header class="fts-card-header"><div><i class="fa-solid fa-table-cells-large" aria-hidden="true"></i><strong>{{localize 'FAW.Sheet.Custom'}}</strong><span class="fts-count">{{model.customFields.length}}</span></div>{{#if editable}}<button type="button" class="fts-subtle-button" data-action="addCustomField"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize 'FAW.Sheet.AddField'}}</button>{{/if}}</header><div class="fts-card-body fts-custom-fields">
          {{#each model.customFields}}
          <div class="fts-custom-field {{#if this.isWide}}is-wide{{/if}}">
            <div class="fts-custom-field-head"><strong>{{this.label}}</strong>{{#if ../editable}}<div class="fts-mini-actions"><button type="button" data-action="editCustomField" data-field-id="{{this.id}}" title="{{localize 'FAW.Sheet.EditField'}}" aria-label="{{localize 'FAW.Sheet.EditField'}}"><i class="fa-solid fa-pen" aria-hidden="true"></i></button><button type="button" data-action="moveCustomFieldUp" data-field-id="{{this.id}}" title="{{localize 'FAW.Sheet.MoveUp'}}" aria-label="{{localize 'FAW.Sheet.MoveUp'}}"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></button><button type="button" data-action="moveCustomFieldDown" data-field-id="{{this.id}}" title="{{localize 'FAW.Sheet.MoveDown'}}" aria-label="{{localize 'FAW.Sheet.MoveDown'}}"><i class="fa-solid fa-arrow-down" aria-hidden="true"></i></button><button type="button" class="is-danger" data-action="deleteCustomField" data-field-id="{{this.id}}" title="{{localize 'FAW.Sheet.DeleteField'}}" aria-label="{{localize 'FAW.Sheet.DeleteField'}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button></div>{{/if}}</div>
            {{#if this.isCounter}}
              <div class="fts-counter"><input data-custom-field-input="{{this.id}}" data-custom-field-prop="value" type="number" value="{{this.value}}" aria-label="{{this.label}}" {{#unless ../editable}}disabled{{/unless}}><span>/</span><input data-custom-field-input="{{this.id}}" data-custom-field-prop="max" type="number" value="{{this.max}}" aria-label="{{this.label}} — {{localize 'FAW.Sheet.FieldMaximum'}}" {{#unless ../editable}}disabled{{/unless}}></div>
            {{else}}
              {{#if this.isToggle}}
                <label class="fts-custom-toggle"><input data-custom-field-input="{{this.id}}" data-custom-field-prop="value" type="checkbox" {{#if this.value}}checked{{/if}} {{#unless ../editable}}disabled{{/unless}}><span>{{#if this.value}}{{localize 'FAW.Sheet.On'}}{{else}}{{localize 'FAW.Sheet.Off'}}{{/if}}</span></label>
              {{else}}
                {{#if ../editable}}
                  {{#if this.isNumber}}<input data-custom-field-input="{{this.id}}" data-custom-field-prop="value" type="number" value="{{this.value}}" aria-label="{{this.label}}">{{else}}
                    {{#if this.placeholder}}<input data-custom-field-input="{{this.id}}" data-custom-field-prop="value" type="text" value="{{this.value}}" placeholder="{{this.placeholder}}" aria-label="{{this.label}}">{{else}}<input data-custom-field-input="{{this.id}}" data-custom-field-prop="value" type="text" value="{{this.value}}" aria-label="{{this.label}}">{{/if}}
                  {{/if}}
                {{else}}<div class="fts-static-field">{{this.value}}</div>{{/if}}
              {{/if}}
            {{/if}}
          </div>
          {{/each}}
          {{#unless model.customFields.length}}<div class="fts-empty-state"><i class="fa-solid fa-table-cells-large" aria-hidden="true"></i><strong>{{localize 'FAW.Sheet.NoCustomFields'}}</strong><span>{{localize 'FAW.Sheet.NoCustomFieldsHint'}}</span></div>{{/unless}}
        </div></section>
        {{/unless}}
      </div>
    </section>
  </main>
</div>
