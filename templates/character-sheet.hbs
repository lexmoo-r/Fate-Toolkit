<div class="fts-shell">
  <header class="fts-header">
    <div class="fts-identity">
      <div class="fts-portrait-button">
        <img data-uuid="{{actor.uuid}}" class="fts-portrait profile-img fco_popviewable" src="{{actor.img}}" alt="{{actor.name}}" data-edit="img" data-action="editImage" title="{{localize 'FAW.Sheet.EditPortrait'}}">
      </div>
      <div class="fts-name-block">
        {{#if editable}}
          <input class="fts-name" name="name" type="text" value="{{actor.name}}" autocomplete="off" aria-label="{{localize 'FAW.Sheet.CharacterName'}}">
          <input class="fts-pronouns" name="system.details.pronouns.value" type="text" value="{{model.pronouns}}" placeholder="{{localize 'FAW.Sheet.Pronouns'}}">
        {{else}}
          <div class="fts-name fts-name-static">{{actor.name}}</div>
          {{#if model.pronouns}}<div class="fts-pronouns fts-pronouns-static">{{model.pronouns}}</div>{{/if}}
        {{/if}}
      </div>
    </div>

    <div class="fts-fate-summary">
      {{#if campaignMode}}
      <div class="fts-fate-stat fts-fate-current-stat fts-will-stat">
        <span class="fts-fate-label">{{localize "FAW.Campaign.Will"}} {{#if campaignWill.configured}}({{#if campaignWill.isPc}}{{localize "FAW.Campaign.PcLabel"}}{{else}}{{localize "FAW.Campaign.NpcLabel"}}{{/if}}){{/if}}</span>
        <div class="fts-fate-value-row">
          {{#if campaignWill.configured}}
            {{#if editable}}<button type="button" data-action="fatePointDown" class="fts-icon-button" title="{{localize "FAW.Campaign.SpendWill"}}">−</button>{{/if}}
            <output class="fts-fate-number" aria-label="{{localize "FAW.Campaign.CurrentWill"}}">{{campaignWill.current}}</output>
            <span aria-label="{{localize "FAW.Campaign.MaxWill"}}">/ {{campaignWill.max}}</span>
            {{#if editable}}<button type="button" data-action="fatePointUp" class="fts-icon-button" title="{{localize "FAW.Campaign.RestoreWill"}}">+</button>{{/if}}
          {{else}}
            <span class="fts-will-unset">{{localize "FAW.Campaign.NotConfigured"}}</span>
          {{/if}}
        </div>
        {{#if campaignWill.configured}}
          <div class="fts-will-boxes" aria-label="{{localize "FAW.Campaign.Will"}}: {{campaignWill.current}} {{localize "FAW.Campaign.Of"}} {{campaignWill.max}}">
            {{#each campaignWill.boxes}}<span class="fts-will-box {{#if this.filled}}filled{{/if}}" aria-hidden="true"></span>{{/each}}
          </div>
        {{/if}}
      </div>
      {{#if campaignWill.complication.pending}}<span class="fts-will-warning" title="{{localize 'FAW.Campaign.ComplicationPending'}}"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i></span>{{/if}}
      {{else}}
      <div class="fts-fate-stat fts-fate-current-stat">
        <span class="fts-fate-label">{{localize 'FAW.Sheet.FatePoints'}}</span>
        <div class="fts-fate-value-row">
          {{#if editable}}<button type="button" data-action="fatePointDown" class="fts-icon-button" title="{{localize 'FAW.Sheet.FatePointDown'}}" aria-label="{{localize 'FAW.Sheet.FatePointDown'}}"><i class="fa-solid fa-minus" aria-hidden="true"></i></button>{{/if}}
          {{#if editable}}<input name="system.details.fatePoints.current" class="fts-fate-number" type="number" min="0" value="{{model.fatePoints.current}}" aria-label="{{localize 'FAW.Sheet.FatePoints'}}">{{else}}<output class="fts-fate-number">{{model.fatePoints.current}}</output>{{/if}}
          {{#if editable}}<button type="button" data-action="fatePointUp" class="fts-icon-button" title="{{localize 'FAW.Sheet.FatePointUp'}}" aria-label="{{localize 'FAW.Sheet.FatePointUp'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>{{/if}}
        </div>
      </div>
      <label class="fts-fate-stat">
        <span class="fts-fate-label">{{localize 'FAW.Sheet.Refresh'}}</span>
        {{#if editable}}<input name="system.details.fatePoints.refresh" class="fts-fate-number" type="number" min="0" value="{{model.fatePoints.refresh}}">{{else}}<output class="fts-fate-number">{{model.fatePoints.refresh}}</output>{{/if}}
      </label>
      <label class="fts-fate-stat">
        <span class="fts-fate-label">{{localize 'FAW.Sheet.Boosts'}}</span>
        {{#if editable}}<input name="system.details.fatePoints.boosts" class="fts-fate-number" type="number" min="0" value="{{model.fatePoints.boosts}}">{{else}}<output class="fts-fate-number">{{model.fatePoints.boosts}}</output>{{/if}}
      </label>
      {{/if}}
      {{#if isGM}}<button type="button" class="fts-header-button" data-action="saveFramework" title="{{localize 'FAW.Sheet.SaveFramework'}}" aria-label="{{localize 'FAW.Sheet.SaveFramework'}}"><i class="fa-solid fa-user-plus" aria-hidden="true"></i><span>{{localize 'FAW.Sheet.SaveFramework'}}</span></button><button type="button" class="fts-header-button" data-action="applyFramework" title="{{localize 'FAW.Sheet.ApplyFramework'}}" aria-label="{{localize 'FAW.Sheet.ApplyFramework'}}"><i class="fa-solid fa-user-pen" aria-hidden="true"></i><span>{{localize 'FAW.Sheet.ApplyFramework'}}</span></button>{{/if}}
      {{#if editable}}<button type="button" class="fts-header-button" data-action="syncTokenName" title="{{localize 'FAW.Sheet.SyncTokenName'}}" aria-label="{{localize 'FAW.Sheet.SyncTokenName'}}"><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i><span>{{localize 'FAW.Sheet.SyncTokenName'}}</span></button>{{/if}}
      <button type="button" class="fts-header-button {{#if customizing}}active{{/if}}" data-action="toggleCustomize" title="{{localize 'FAW.Sheet.Customize'}}" aria-pressed="{{#if customizing}}true{{else}}false{{/if}}"><i class="fa-solid fa-sliders" aria-hidden="true"></i><span>{{localize 'FAW.Sheet.Customize'}}</span></button>
    </div>
  </header>

  {{#if campaignMode}}
    <div class="fts-campaign-tools" aria-label="{{localize 'FAW.Campaign.CharacterRoleWill'}}">
      {{#if campaignWill.configured}}
        <div class="fts-campaign-play-actions">
          {{#if editable}}<button type="button" class="fts-campaign-action" data-action="spendSpecialWill"><i class="fa-solid fa-bolt" aria-hidden="true"></i> {{localize "FAW.Campaign.SpecialSpend"}}</button>{{/if}}
          {{#if campaignWill.isPc}}{{#if editable}}<button type="button" class="fts-campaign-action" data-action="recoverWillVice"><i class="fa-solid fa-heart-pulse" aria-hidden="true"></i> {{localize "FAW.Campaign.ViceRecovery"}}</button>{{/if}}{{/if}}
          {{#if isGM}}<button type="button" class="fts-campaign-action" data-action="gainCompelWill"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "FAW.Campaign.Compel"}}</button>{{/if}}
          {{#if campaignWill.complication.pending}}{{#if isGM}}<button type="button" class="fts-campaign-action" data-action="resolveWillComplication">{{localize "FAW.Campaign.ResolveComplication"}}</button>{{/if}}{{/if}}
        </div>
      {{else}}
        <span class="fts-campaign-unset">{{localize 'FAW.Campaign.NotConfigured'}}</span>
        {{#if isGM}}<button type="button" class="fts-campaign-action" data-action="configureWillPc">{{localize 'FAW.Campaign.PcSetup'}}</button>{{/if}}
      {{/if}}
      {{#if isGM}}
      <details class="fts-campaign-settings" {{#if campaignSettingsOpen}}open{{/if}}>
        <summary><i class="fa-solid fa-gear" aria-hidden="true"></i> {{localize 'FAW.Campaign.GmSettings'}} <i class="fa-solid fa-angle-down fts-campaign-chevron" aria-hidden="true"></i></summary>
        <div class="fts-campaign-settings-grid">
          <fieldset class="fts-campaign-role"><legend>{{localize 'FAW.Campaign.PcLabel'}} / {{localize 'FAW.Campaign.NpcLabel'}}</legend>
            <button type="button" data-action="configureWillPc" class="fts-campaign-action {{#if campaignWill.configured}}{{#if campaignWill.isPc}}is-current{{/if}}{{/if}}" {{#if campaignWill.configured}}{{#if campaignWill.isPc}}disabled{{/if}}{{/if}}>{{localize 'FAW.Campaign.PcSetup'}}</button>
            <label class="fts-campaign-tier"><span>{{localize 'FAW.Campaign.NpcTier'}}</span>
              <select data-campaign-npc-tier aria-label="{{localize 'FAW.Campaign.NpcTier'}}">
                <option value="rank" {{#if campaignNpcTierRank}}selected{{/if}}>{{localize 'FAW.Campaign.RankNpc'}}</option>
                <option value="ordinary" {{#if campaignNpcTierOrdinary}}selected{{/if}}>{{localize 'FAW.Campaign.OrdinaryNpc'}}</option>
                <option value="powerful" {{#if campaignNpcTierPowerful}}selected{{/if}}>{{localize 'FAW.Campaign.PowerfulNpc'}}</option>
                <option value="legendary" {{#if campaignNpcTierLegendary}}selected{{/if}}>{{localize 'FAW.Campaign.LegendaryNpc'}}</option>
              </select>
            </label>
            <button type="button" data-action="configureWillNpc" class="fts-campaign-action {{#if campaignWill.configured}}{{#if campaignWill.isNpc}}is-current{{/if}}{{/if}}">{{localize 'FAW.Campaign.ConfigureNpc'}}</button>
          </fieldset>

        </div>
        <details class="fts-gm-advanced"><summary>{{localize 'FAW.Campaign.TechnicalSettings'}}</summary>        <section class="fts-card fts-system-audit-card">
          <header class="fts-card-header"><div><i class="fa-solid fa-scale-balanced" aria-hidden="true"></i><strong>{{localize 'FAW.Sheet.SystemAudit'}}</strong></div></header>
          <div class="fts-card-body fts-system-audit">
            <label title="{{localize 'FAW.Campaign.StuntRefreshHint'}}"><span>{{localize 'FAW.Campaign.StuntRefresh'}}</span><input name="system.details.fatePoints.refresh" type="number" min="0" value="{{model.fatePoints.refresh}}"></label>
            <div class="fts-audit-stat"><span>{{localize 'FAW.Sheet.GameRefresh'}}</span><strong>{{model.systemRules.gameRefresh}}</strong></div>
            <div class="fts-audit-stat"><span>{{localize 'FAW.Sheet.RefreshSpent'}}</span><strong>{{model.systemRules.refreshSpent}}</strong></div>
            <div class="fts-audit-stat"><span>{{localize 'FAW.Sheet.SkillPointsSpent'}}</span><strong>{{model.systemRules.skillPointsSpent}}</strong></div>
            <div class="fts-audit-stat"><span>{{localize 'FAW.Sheet.SkillPointsAllowed'}}</span><strong>{{model.systemRules.skillPointsAllowed}}</strong></div>
            <label class="fts-audit-toggle"><input type="checkbox" name="system.override.active" {{#if model.systemRules.overrideActive}}checked{{/if}}> <span>{{localize 'FAW.Sheet.OverrideWorldSettings'}}</span></label>
            <label><span>{{localize 'FAW.Sheet.OverrideRefresh'}}</span><input type="number" min="0" name="system.override.refresh" value="{{model.systemRules.overrideRefresh}}"></label>
            <label><span>{{localize 'FAW.Sheet.OverrideSkillPoints'}}</span><input type="number" min="0" name="system.override.skillPoints" value="{{model.systemRules.overrideSkillPoints}}"></label>
          </div>
        </section>
</details>
      </details>
      {{/if}}
    </div>
  {{/if}}

  {{#unless campaignMode}}{{#if isGM}}<details class="fts-standard-gm-settings"><summary>{{localize 'FAW.Sheet.SystemAudit'}}</summary>        <section class="fts-card fts-system-audit-card">
          <header class="fts-card-header"><div><i class="fa-solid fa-scale-balanced" aria-hidden="true"></i><strong>{{localize 'FAW.Sheet.SystemAudit'}}</strong></div></header>
          <div class="fts-card-body fts-system-audit">
            <label title="{{localize 'FAW.Campaign.StuntRefreshHint'}}"><span>{{localize 'FAW.Campaign.StuntRefresh'}}</span><input name="system.details.fatePoints.refresh" type="number" min="0" value="{{model.fatePoints.refresh}}"></label>
            <div class="fts-audit-stat"><span>{{localize 'FAW.Sheet.GameRefresh'}}</span><strong>{{model.systemRules.gameRefresh}}</strong></div>
            <div class="fts-audit-stat"><span>{{localize 'FAW.Sheet.RefreshSpent'}}</span><strong>{{model.systemRules.refreshSpent}}</strong></div>
            <div class="fts-audit-stat"><span>{{localize 'FAW.Sheet.SkillPointsSpent'}}</span><strong>{{model.systemRules.skillPointsSpent}}</strong></div>
            <div class="fts-audit-stat"><span>{{localize 'FAW.Sheet.SkillPointsAllowed'}}</span><strong>{{model.systemRules.skillPointsAllowed}}</strong></div>
            <label class="fts-audit-toggle"><input type="checkbox" name="system.override.active" {{#if model.systemRules.overrideActive}}checked{{/if}}> <span>{{localize 'FAW.Sheet.OverrideWorldSettings'}}</span></label>
            <label><span>{{localize 'FAW.Sheet.OverrideRefresh'}}</span><input type="number" min="0" name="system.override.refresh" value="{{model.systemRules.overrideRefresh}}"></label>
            <label><span>{{localize 'FAW.Sheet.OverrideSkillPoints'}}</span><input type="number" min="0" name="system.override.skillPoints" value="{{model.systemRules.overrideSkillPoints}}"></label>
          </div>
        </section>
</details>{{/if}}{{/unless}}
  <nav class="fts-tabs" aria-label="{{localize 'FAW.Sheet.Navigation'}}">
    <div class="fts-tab-set" role="tablist" aria-label="{{localize 'FAW.Sheet.Navigation'}}">
      <button type="button" role="tab" tabindex="{{#if playActive}}0{{else}}-1{{/if}}" aria-selected="{{#if playActive}}true{{else}}false{{/if}}" aria-controls="fts-panel-play" id="fts-tab-play" data-action="changeTab" data-tab="play" class="fts-tab-button {{#if playActive}}active{{/if}}"><i class="fa-solid fa-bolt" aria-hidden="true"></i><span>{{localize 'FAW.Sheet.Play'}}</span></button>
      <button type="button" role="tab" tabindex="{{#if storyActive}}0{{else}}-1{{/if}}" aria-selected="{{#if storyActive}}true{{else}}false{{/if}}" aria-controls="fts-panel-story" id="fts-tab-story" data-action="changeTab" data-tab="story" class="fts-tab-button {{#if storyActive}}active{{/if}}"><i class="fa-solid fa-book-open" aria-hidden="true"></i><span>{{localize 'FAW.Sheet.Story'}}</span></button>
      <button type="button" role="tab" tabindex="{{#if developmentActive}}0{{else}}-1{{/if}}" aria-selected="{{#if developmentActive}}true{{else}}false{{/if}}" aria-controls="fts-panel-development" id="fts-tab-development" data-action="changeTab" data-tab="development" class="fts-tab-button {{#if developmentActive}}active{{/if}}"><i class="fa-solid fa-timeline" aria-hidden="true"></i><span>{{localize 'FMS.Timeline.Development'}}</span></button>
    </div>
    <button type="button" data-action="openActionWidget" class="fts-tab-button fts-open-action"><i class="fa-solid fa-dice" aria-hidden="true"></i><span>{{localize 'FAW.Sheet.ActionCenter'}}</span></button>
  </nav>

  {{#if customizing}}
  <aside class="fts-customizer">
    <div class="fts-customizer-head">
      <div><strong>{{localize 'FAW.Sheet.PersonalLayout'}}</strong><small>{{localize 'FAW.Sheet.PersonalLayoutHint'}}</small></div>
      <button type="button" data-action="resetLayout" class="fts-subtle-button"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> {{localize 'FAW.Sheet.Reset'}}</button>
    </div>
    <div class="fts-customizer-options">
      <div class="fts-option-group" role="group" aria-label="{{localize 'FAW.Sheet.Density'}}">
        <span>{{localize 'FAW.Sheet.Density'}}</span>
        <button type="button" data-action="setDensity" data-density="standard" class="{{#if densityStandard}}active{{/if}}" aria-pressed="{{#if densityStandard}}true{{else}}false{{/if}}">{{localize 'FAW.Sheet.Standard'}}</button>
        <button type="button" data-action="setDensity" data-density="compact" class="{{#if densityCompact}}active{{/if}}" aria-pressed="{{#if densityCompact}}true{{else}}false{{/if}}">{{localize 'FAW.Sheet.Compact'}}</button>
        <button type="button" data-action="setDensity" data-density="comfortable" class="{{#if densityComfortable}}active{{/if}}" aria-pressed="{{#if densityComfortable}}true{{else}}false{{/if}}">{{localize 'FAW.Sheet.Comfortable'}}</button>
      </div>
      <div class="fts-option-group" role="group" aria-label="{{localize 'FAW.Sheet.Theme'}}">
        <span>{{localize 'FAW.Sheet.Theme'}}</span>
        <button type="button" data-action="setTheme" data-theme="foundry" class="{{#if themeFoundry}}active{{/if}}" aria-pressed="{{#if themeFoundry}}true{{else}}false{{/if}}">{{localize 'FAW.Sheet.ThemeFoundry'}}</button>
        <button type="button" data-action="setTheme" data-theme="paper" class="{{#if themePaper}}active{{/if}}" aria-pressed="{{#if themePaper}}true{{else}}false{{/if}}">{{localize 'FAW.Sheet.ThemePaper'}}</button>
        <button type="button" data-action="setTheme" data-theme="midnight" class="{{#if themeMidnight}}active{{/if}}" aria-pressed="{{#if themeMidnight}}true{{else}}false{{/if}}">{{localize 'FAW.Sheet.ThemeMidnight'}}</button>
      </div>
      <label class="fts-option-group fts-accent-option">
        <span>{{localize 'FAW.Sheet.Accent'}}</span>
        <input type="color" value="{{accent}}" data-sheet-accent aria-label="{{localize 'FAW.Sheet.Accent'}}">
      </label>
    </div>
    <div class="fts-layout-list">
      {{#each customizerSections}}
      <div class="fts-layout-row {{#if this.hidden}}is-hidden{{/if}}" draggable="true" data-layout-section="{{this.key}}">
        <span class="fts-layout-name"><i class="fa-solid fa-grip-vertical fts-drag-grip" aria-hidden="true"></i>{{this.name}}</span>
        <span class="fts-layout-tab">{{this.tab}}</span>
        <div class="fts-layout-actions">
          <button type="button" data-action="moveSectionUp" data-section="{{this.key}}" title="{{localize 'FAW.Sheet.MoveUp'}}" aria-label="{{localize 'FAW.Sheet.MoveUp'}}"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></button>
          <button type="button" data-action="moveSectionDown" data-section="{{this.key}}" title="{{localize 'FAW.Sheet.MoveDown'}}" aria-label="{{localize 'FAW.Sheet.MoveDown'}}"><i class="fa-solid fa-arrow-down" aria-hidden="true"></i></button>
          {{#if this.canToggleWide}}<button type="button" data-action="toggleSectionWide" data-section="{{this.key}}" class="{{#if this.wide}}active{{/if}}" title="{{localize 'FAW.Sheet.ToggleWide'}}" aria-label="{{localize 'FAW.Sheet.ToggleWide'}}" aria-pressed="{{#if this.wide}}true{{else}}false{{/if}}"><i class="fa-solid fa-arrows-left-right" aria-hidden="true"></i></button>{{/if}}
          <button type="button" data-action="toggleSectionHidden" data-section="{{this.key}}" class="{{#if this.hidden}}active{{/if}}" title="{{localize 'FAW.Sheet.ToggleSection'}}" aria-label="{{localize 'FAW.Sheet.ToggleSection'}}" aria-pressed="{{#if this.hidden}}true{{else}}false{{/if}}"><i class="fa-solid {{#if this.hidden}}fa-eye-slash{{else}}fa-eye{{/if}}" aria-hidden="true"></i></button>
        </div>
      </div>
      {{/each}}
    </div>
  </aside>
  {{/if}}

  <main class="fts-body">
    <section class="fts-tab-panel {{#unless playActive}}fts-tab-hidden{{/unless}}" id="fts-panel-play" role="tabpanel" aria-labelledby="fts-tab-play" data-sheet-tab="play">
      {{#if model.favorites.length}}
      <div class="fts-favorites">
        <span class="fts-favorites-label"><i class="fa-solid fa-star" aria-hidden="true"></i> {{localize 'FAW.Sheet.Favorites'}}</span>
        <div class="fts-favorite-chips" role="group" aria-label="{{localize 'FAW.Sheet.Favorites'}}">
          {{#each model.favorites}}
          <button type="button" class="fts-favorite-chip" data-action="scrollFavorite" data-kind="{{this.kind}}" data-key="{{this.key}}">
            <span>{{this.label}}</span>{{#if this.meta}}<small>{{this.meta}}</small>{{/if}}
          </button>
          {{/each}}
        </div>
      </div>
      {{/if}}

      <div class="fts-section-grid {{#if smartPlayLayout}}fts-smart-play-grid{{/if}}">
        {{#unless sections.aspects.hidden}}
        <section class="fts-card {{#if sections.aspects.wide}}fts-section-wide{{/if}}" style="order:{{sections.aspects.order}}" data-section="aspects">
          <header class="fts-card-header"><div class="fts-card-heading"><i class="fa-solid fa-quote-left" aria-hidden="true"></i><strong>{{localize 'FAW.Sheet.Aspects'}}</strong><span class="fts-count">{{model.aspects.length}}</span>{{#if isGM}}<button type="button" class="fts-card-tool" data-action="manageAspects" title="{{localize 'FAW.Sheet.ManageAspects'}}"><i class="fa-solid fa-gear" aria-hidden="true"></i><span>{{localize 'FAW.Sheet.ManageAspects'}}</span></button>{{/if}}</div><span class="fts-search-control"><input data-sheet-search="aspects" type="search" placeholder="{{localize 'FAW.Sheet.Search'}}" aria-label="{{localize 'FAW.Sheet.Search'}}" aria-controls="fts-list-aspects" aria-describedby="fts-search-status-aspects"><span class="fts-search-count" id="fts-search-status-aspects" data-sheet-search-status="aspects" aria-live="polite"></span></span></header>
          <div class="fts-card-body fts-list" id="fts-list-aspects" data-search-group="aspects">
            {{#each model.aspects}}
            <article class="fts-aspect-row" data-search-text="{{this.search}}" data-favorite-anchor="aspects:{{this.key}}" {{#if ../isGM}}draggable="true" data-fco-drag-type="aspect" data-fco-drag-key="{{this.key}}"{{/if}}>
              <div class="fts-row-title">
                <button type="button" class="fts-star {{#if this.favorite}}active{{/if}}" data-action="toggleFavorite" title="{{localize 'FAW.Sheet.Favorite'}}" aria-label="{{localize 'FAW.Sheet.Favorite'}}" aria-pressed="{{#if this.favorite}}true{{else}}false{{/if}}" data-kind="aspects" data-key="{{this.key}}"><i class="fa-solid fa-star" aria-hidden="true"></i></button>
                <strong>{{this.name}}</strong>
              </div>
              {{#if ../editable}}
                <textarea class="fts-multiline-value" name="system.aspects.{{this.key}}.value" rows="3" placeholder="{{this.name}}">{{this.value}}</textarea>
              {{else}}<div class="fts-aspect-value">{{this.value}}</div>{{/if}}
              {{#if this.hasDetails}}
              <details class="fts-native-details">
                <summary>{{localize 'FAW.Sheet.Details'}}</summary>
                {{#if this.description}}<div class="fts-native-rich-block"><strong>{{localize 'FAW.Sheet.AspectDescription'}}</strong><div class="fts-prose editor-content">{{{this.descriptionEnriched}}}</div></div>{{/if}}
                {{#if ../editable}}{{#unless this.extraOwned}}<div class="fts-native-rich-block"><strong>{{localize 'FAW.Sheet.AspectNotes'}}</strong><prose-mirror toggled="true" name="system.aspects.{{this.key}}.notes" value="{{this.notes}}" data-document-u-u-i-d="{{../actor.uuid}}" collaborate="true" class="fts-rich-editor fts-inline-rich-editor">{{{this.notesEnriched}}}</prose-mirror></div>{{else}}{{#if this.notes}}<div class="fts-native-rich-block"><strong>{{localize 'FAW.Sheet.AspectNotes'}}</strong><div class="fts-prose editor-content">{{{this.notesEnriched}}}</div></div>{{/if}}{{/unless}}{{else}}{{#if this.notes}}<div class="fts-native-rich-block"><strong>{{localize 'FAW.Sheet.AspectNotes'}}</strong><div class="fts-prose editor-content">{{{this.notesEnriched}}}</div></div>{{/if}}{{/if}}
              </details>
              {{/if}}
            </article>
            {{/each}}
            {{#unless model.aspects.length}}<div class="fts-empty-state"><i class="fa-regular fa-comment-dots" aria-hidden="true"></i><strong>{{localize 'FAW.Sheet.NoAspects'}}</strong><span>{{localize 'FAW.Sheet.NoAspectsHint'}}</span></div>{{/unless}}
          </div>
        </section>
        {{/unless}}

        {{#unless sections.skills.hidden}}
        <section class="fts-card {{#if sections.skills.wide}}fts-section-wide{{/if}}" style="order:{{sections.skills.order}}" data-section="skills">
          <header class="fts-card-header"><div><i class="fa-solid fa-chart-simple" aria-hidden="true"></i><strong>{{localize 'FAW.Sheet.Skills'}}</strong><span class="fts-count">{{model.skills.length}}</span>{{#if editable}}<button type="button" class="fts-card-tool" data-action="editSkills" title="{{localize 'FAW.Sheet.EditSkills'}}" aria-label="{{localize 'FAW.Sheet.EditSkills'}}"><i class="fa-solid fa-gear" aria-hidden="true"></i><span>{{localize 'FAW.Sheet.EditSkills'}}</span></button>{{/if}}</div><span class="fts-search-control"><input data-sheet-search="skills" type="search" placeholder="{{localize 'FAW.Sheet.Search'}}" aria-label="{{localize 'FAW.Sheet.Search'}}" aria-controls="fts-list-skills" aria-describedby="fts-search-status-skills"><span class="fts-search-count" id="fts-search-status-skills" data-sheet-search-status="skills" aria-live="polite"></span></span></header>
          <div class="fts-card-body fts-skill-grid" id="fts-list-skills" data-search-group="skills">
