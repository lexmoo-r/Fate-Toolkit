<div class="frr-player-requests">
  {{#if requests.length}}
    <div class="frr-player-request-list">
      {{#each requests}}
        <article class="frr-card" data-request-id="{{id}}">
          <div class="frr-card-head">
            <div class="frr-card-icon"><i class="fa-solid fa-dice" aria-hidden="true"></i></div>
            <div>
              <div class="frr-card-title">{{title}}</div>
              <div class="frr-card-meta">{{localize "FRR.RequestFrom"}}: {{gmName}} · {{actionLabel}}</div>
            </div>
          </div>
          <div class="frr-card-body">
            <p>{{skillText}}</p>
            <p>{{{oppositionText}}}</p>
            {{#if description}}<p>{{description}}</p>{{/if}}
            {{#unless canRoll}}<p class="frr-hidden"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {{localize "FRR.CannotRollActor"}}</p>{{/unless}}
          </div>
          <div class="frr-card-actions faw-context-actions">
            <button type="button" class="faw-context-primary" data-action="roll-request" data-request-id="{{id}}" {{#unless canRoll}}disabled{{/unless}}>
              <i class="fa-solid fa-dice" aria-hidden="true"></i> {{localize "FRR.Roll"}}
            </button>
            <details class="faw-context-menu">
              <summary title="{{localize 'FRR.MoreActions'}}" aria-label="{{localize 'FRR.MoreActions'}}"><i class="fa-solid fa-ellipsis" aria-hidden="true"></i></summary>
              <div class="faw-context-menu-popover">
                <button type="button" class="is-danger" data-action="decline-request" data-request-id="{{id}}"><i class="fa-solid fa-xmark" aria-hidden="true"></i><span>{{localize "FRR.Decline"}}</span></button>
              </div>
            </details>
          </div>
        </article>
      {{/each}}
    </div>
  {{else}}
    <div class="frr-player-empty">
      <span class="frr-empty-icon"><i class="fa-solid fa-dice" aria-hidden="true"></i></span>
      <strong>{{localize "FRR.NoPendingRequests"}}</strong>
      <p>{{localize "FRR.NoPendingRequestsHint"}}</p>
    </div>
  {{/if}}
</div>
